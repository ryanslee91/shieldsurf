{
  "manifest_version": 3,
  "name": "ShieldSurf",
  "version": "0.1",
  "description": "실시간 URL/파일 위협 인텔리전스 확장",
  "permissions": [
    "storage",
    "downloads",
    "tabs",
    "scripting",
    "activeTab",
    "https://safebrowsing.googleapis.com/"
  ],
  "background": {
    "service_worker": "src/background/background.ts"
  },
    "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/contentScript.ts"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}